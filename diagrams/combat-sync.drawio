ry x="50" y="294" width="360" height="26" as="geometry"/></mxCell><mxCell id="c8" value="Hit_2 (Immediate) → 즉시 데미지 적용" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#fff7e6;strokeColor=#d9a12b;fontColor=#1e293b;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="326" width="360" height="26" as="geometry"/></mxCell><mxCell id="c9" value="CLIENT: Hit_1 Lazy 데미지 적용" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#fff7e6;strokeColor=#d9a12b;fontColor=#1e293b;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="408" width="360" height="30" as="geometry"/></mxCell><mxCell id="c10" value="1. CastCmd (skill_id, target_id)" style="html=1;endArrow=block;strokeColor=#7787a2;fontSize=10;fontColor=#475569;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="230" y="122" as="sourcePoint"/><mxPoint x="630" y="122" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" value="2. SkillCastResultEvt (Success)" style="html=1;endArrow=block;strokeColor=#7787a2;fontSize=10;fontColor=#475569;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="630" y="160" as="sourcePoint"/><mxPoint x="230" y="160" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c12" value="3. ActionEvt (NotifyInfoList 포함)" style="html=1;endArrow=block;strokeColor=#7787a2;fontSize=10;fontColor=#475569;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="630" y="198" as="sourcePoint"/><mxPoint x="230" y="198" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c13" value="4. LazyHitNotifyEvt (Hit_1 데미지)" style="html=1;endArrow=block;strokeColor=#7787a2;fontSize=10;fontColor=#475569;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="630" y="386" as="sourcePoint"/><mxPoint x="230" y="386" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="5. ChangeStatusEffectEvt (버프 / 디버프 / CC)" style="html=1;endArrow=block;strokeColor=#7787a2;fontSize=10;fontColor=#475569